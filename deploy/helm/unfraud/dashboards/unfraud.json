{
 "title": "unfraud",
 "uid": "unfraud",
 "schemaVersion": 39,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "type": "timeseries",
   "title": "Scorer: Decisions per second by action",
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "sum by (profile, action) (rate(unfraud_scorer_decisions_total[1m]))",
     "legendFormat": "{{profile}} {{action}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Scorer: time to score one Event",
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le, profile) (rate(unfraud_scorer_process_seconds_bucket[1m])))",
     "legendFormat": "p50 {{profile}}",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le, profile) (rate(unfraud_scorer_process_seconds_bucket[1m])))",
     "legendFormat": "p99 {{profile}}",
     "refId": "B"
    }
   ]
  },

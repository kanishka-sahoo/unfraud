# Copy to .env (git-ignored) and run `make secrets` to load the keys into the cluster.
# Set the key for the Summary driver you use (deploy/helm/unfraud/values.yaml, ADR-0021).
# driver=anthropic: the Claude API or any Anthropic-compatible API. The assistant
# chat always uses Claude and needs this key (ADR-0022).
ANTHROPIC_API_KEY=
# driver=openai: any OpenAI-compatible API (set assistant.summaries.baseURL).
OPENAI_API_KEY=
# driver=openrouter.
OPENROUTER_API_KEY=
